knitr::opts_chunk$set(echo = TRUE)
dane_projekt <- read.csv('cbb.csv')
dim(dane_projekt)  # wymiary(wiersze, kolumny)
head(dane_projekt) # wyswietlam kilka pierwszych wierszy
colSums(is.na(dane_projekt)) # sprawdzam braki danych
dane_projekt$WIN_PCT <- round((dane_projekt$W/ dane_projekt$G) * 100, 2)
head(dane_projekt[, c("TEAM", "CONF", "YEAR", "G", "W", "WIN_PCT", "SEED")])
library(tidyverse)
dane_projekt |>
select(where(is.numeric)) |>
pivot_longer(
cols = everything(),
names_to = "variable",
values_to = "value"
) |>
ggplot(aes(x = value))+
geom_histogram(bins = 30, fill = "steelblue", color = "white")+
facet_wrap(~ variable, scales = "free")+
theme_minimal()+
labs(
title = "Histogramy",
x = "Wartość",
y = "Liczebność"
)
library(DataExplorer)
install.packages("DataExplorer")
plot_histogram(dane_projekt)
library(DataExplorer)
plot_histogram(dane_projekt)
View(dane_projekt)
